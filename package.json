{
  "name": "jev-page-checker",
  "private": true,
  "version": "1.2.0",
  "description": "表示中のタブを追跡し、TypeSafe の Jev でサイトと本文の信憑性を検査する Chrome 拡張",
  "homepage": "https://github.com/s-hiraoku/jev-page-checker",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "preview": "vite --config vite.preview.config.ts --port 4173",
    "test": "node --import tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/jsdom": "28.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "28.0.0",
    "@vitejs/plugin-react": "5.1.4",
    "@wxt-dev/module-react": "1.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wxt": "0.20.18"
  }
}
