{
  "name": "jev-page-checker",
  "private": true,
  "version": "1.3.0",
  "description": "Follow the current tab and audit site plus body with TypeSafe Jev",
  "homepage": "https://github.com/s-hiraoku/jev-page-checker",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt build && python3 scripts/pack-chrome-zip.py",
    "typecheck": "wxt prepare && tsc --noEmit",
    "preview": "vite --config vite.preview.config.ts --port 4173",
    "test": "wxt prepare && node --import tsx --test src/lib/*.test.ts",
    "compare": "node --import tsx scripts/compare-engines.ts",
    "eval": "node --import tsx scripts/eval-run.ts",
    "eval:capture": "node --import tsx scripts/eval-capture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@typesafe-ai/sdk": "0.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wxt": "0.21.4"
  }
}
